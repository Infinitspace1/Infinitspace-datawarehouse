# NEXUDUS_BEARER_TOKEN=<your_nexudus_bearer_token_here>

NEXUDUS_USERNAME=<your_nexudus_username_here>
NEXUDUS_PASSWORD=<your_nexudus_password_here>

# PRODUCTION
# AZURE_SQL_CONNECTION_STRING=<your_connection_string_here>

# LOCALLY
AZURE_SQL_CONNECTION_STRING=<your_connection_string_here>

ANTHROPIC_API_KEY=<your_anthropic_api_key_here>
GOOGLE_MAPS_API_KEY=<your_google_maps_api_key_here>

AZURE_STORAGE_ACCOUNT_NAME=<your_storage_account_name_here>
AZURE_STORAGE_CONTAINER_RAW_NEXUDUS=<your_container_name_here>

# Function registration flags
ENABLE_ETL_FUNCTIONS=1
ENABLE_ADMIN_FUNCTIONS=0
ENABLE_REAL_ESTATE_FUNCTIONS=0

# Real Estate — CoStar PDF extractor
# Queue: costar-extraction-tasks (auto-created on first use, uses AzureWebJobsStorage)
# Blob: uses DefaultAzureCredential + AZURE_STORAGE_ACCOUNT_NAME (already set above)
#   → ensure the Function App managed identity has Storage Blob Data Contributor on staccinfinitspaceprod001
# AZURE_SQL_PDF_JOBS_CONNECTION_STRING=<real-estate-sql-connection-string>
# AZURE_SQL_PDF_JOBS_TABLE=bronze.costar_pdf_extractor_logs
# BLOB_CONTAINER_NAME=real-estate-costar-automation
# BLOB_FOLDER_UPLOADS=pdf-uploads
# BLOB_FOLDER_OUTPUTS=excel-outputs

# BambooHR
BAMBOOHR_SUBDOMAIN=<your_bamboohr_subdomain>
BAMBOOHR_API_KEY=<your_bamboohr_api_key>
# Optional: override the default 05:00 UTC schedule
# BAMBOOHR_SYNC_SCHEDULE="0 0 5 * * *"

# Sync health report (Microsoft Graph)
# Requires an Azure AD App Registration with Mail.Send application permission
# granted (admin consent) on the sender mailbox (GRAPH_SENDER_UPN).
GRAPH_TENANT_ID=<your_aad_tenant_id>
GRAPH_CLIENT_ID=<your_app_registration_client_id>
GRAPH_CLIENT_SECRET=<your_app_registration_client_secret>
GRAPH_SENDER_UPN=info@infinitspace.com
SYNC_REPORT_RECIPIENTS=bryan.swannie@infinitspace.com,baptiste.valentin@infinitspace.com
# Optional overrides
# SYNC_HEALTH_REPORT_SCHEDULE="0 0 6 * * *"
# SYNC_REPORT_LOOKBACK_HOURS=24

# Xero
XERO_CLIENT_ID=<your_xero_client_id_here>
XERO_CLIENT_SECRET=<your_xero_client_secret_here>
# Use a copy/paste redirect when completing OAuth with xero_complete_oauth.py
XERO_REDIRECT_URI=https://xero.com
INTEGRATIONS_ENCRYPTION_KEY=<your_integrations_encryption_key_here>
XERO_SCOPES="offline_access accounting.invoices accounting.payments accounting.banktransactions accounting.manualjournals accounting.invoices.read accounting.payments.read accounting.banktransactions.read accounting.manualjournals.read accounting.settings.read"
