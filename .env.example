# NEXUDUS_BEARER_TOKEN=<your_nexudus_bearer_token_here>

NEXUDUS_USERNAME=<your_nexudus_username_here>
NEXUDUS_PASSWORD=<your_nexudus_password_here>

# PRODUCTION
# AZURE_SQL_CONNECTION_STRING=<your_connection_string_here>

# LOCALLY
AZURE_SQL_CONNECTION_STRING=<your_connection_string_here>

ANTHROPIC_API_KEY=<your_anthropic_api_key_here>
GOOGLE_MAPS_API_KEY=<your_google_maps_api_key_here>

AZURE_STORAGE_ACCOUNT_NAME=<your_storage_account_name_here>
AZURE_STORAGE_CONTAINER_RAW_NEXUDUS=<your_container_name_here>

# Function registration flags
ENABLE_ETL_FUNCTIONS=1
ENABLE_ADMIN_FUNCTIONS=0
ENABLE_REAL_ESTATE_FUNCTIONS=0
ENABLE_LOCATION_SCRAPER_FUNCTIONS=0
ENABLE_COMPETENCE_FUNCTIONS=0
ENABLE_HUBSPOT_FUNCTIONS=0
ENABLE_EVENTBRITE_FUNCTIONS=0

# HubSpot marketing emails sync (content + KPI stats -> bronze + silver).
# Set ENABLE_HUBSPOT_FUNCTIONS=1 to activate the daily 05:45 UTC timer.
# Create a private app under Settings -> Integrations -> Private Apps with the
# `content` scope and paste its access token here.
HUBSPOT_ACCESS_TOKEN=<your_hubspot_private_app_token>
# Optional overrides:
# HUBSPOT_SYNC_SCHEDULE="0 45 5 * * *"
# HUBSPOT_RECONCILE_MIN_IDS=5

# Eventbrite events sync (all orgs, all statuses -> bronze + silver).
# Set ENABLE_EVENTBRITE_FUNCTIONS=1 to activate the daily 05:50 UTC timer.
# Copy the private token from https://www.eventbrite.com/platform/api-keys
# (Account Settings -> Developer Links -> API Keys) — no OAuth flow needed
# for first-party access to your own organization.
EVENTBRITE_PRIVATE_TOKEN=<your_eventbrite_private_token>
# Optional: pin one organization (otherwise every org the token can access is synced)
# EVENTBRITE_ORGANIZATION_ID=<organization_id>
# Optional overrides:
# EVENTBRITE_SYNC_SCHEDULE="0 50 5 * * *"
# EVENTBRITE_RECONCILE_MIN_IDS=1

# Firebase competence_new sync (TeamAndy competitor lists -> bronze + silver).
# Set ENABLE_COMPETENCE_FUNCTIONS=1 to activate it: incremental daily read (Mon-Sat
# 04:30 UTC) + weekly full read & soft-delete reconcile (Sun 04:00 UTC).
# Provide ONE of the following two credential sources:
#   - FIREBASE_CREDENTIALS: the service-account JSON as a string (used as the Azure
#     app setting; the same value the TeamAndy scraping services use).
#   - FIREBASE_SERVICE_ACCOUNT_KEY_FILE: a local path to, or a download URL for, the
#     service-account key file (the TeamAndy backend stores a Google Drive URL here).
FIREBASE_CREDENTIALS=<firebase_service_account_json>
# FIREBASE_SERVICE_ACCOUNT_KEY_FILE=C:\path\to\serviceAccountKey.json
# The incremental read needs a Firestore COLLECTION_GROUP index on
# competitors.updated_at (Firestore returns a creation link the first time it runs;
# until the index exists the run falls back to a full read).
# Optional overrides:
# COMPETENCE_SYNC_SCHEDULE="0 30 4 * * 1-6"          # incremental, Mon-Sat
# COMPETENCE_FULL_SYNC_SCHEDULE="0 0 4 * * 0"        # full read + reconcile, Sun
# COMPETENCE_INCREMENTAL_OVERLAP_MINUTES=60          # clock-skew re-read buffer
# COMPETENCE_RECONCILE_MIN_IDS=10

# Location Scraper (Durable Functions)
APIFY_TOKEN=<your_apify_token_here>
LUSHA_API_KEY=<your_lusha_api_key_here>
# Optional: first day of each month at 01:00 UTC; starts one unlimited run per configured city
# LOCATION_SCRAPER_MONTHLY_SCHEDULE="0 0 1 1 * *"
# Weekly all-city scrape. Keep it OUT of the small hours: the LoopNet actor
# recovers 95-100% of its listings mid-morning UTC and 19-29% at 01:00 UTC.
# LOCATION_SCRAPER_WEEKLY_SCHEDULE="0 0 8 * * 1"
# Mid-week second pass over the cities that did not complete on Monday (no-op
# when the week is clean).
# LOCATION_SCRAPER_WEEKLY_RETRY_SCHEDULE="0 0 8 * * 3"
# Graded retries: a scrape that comes back far below the city's normal volume,
# or whose actor dropped too many listings, is re-run instead of accepted.
# LOCATION_SCRAPER_MAX_ATTEMPTS=3
# LOCATION_SCRAPER_RETRY_DELAY_MINUTES=30
# LOCATION_SCRAPER_DETAIL_LOSS_THRESHOLD=0.20
# LOCATION_SCRAPER_BASELINE_RATIO=0.6
# LOCATION_SCRAPER_BASELINE_RUNS=8
# LoopNet gb/ca listing-URL enumeration retries (0 URLs is a transient block).
# LOCATION_SCRAPER_ENUM_ATTEMPTS=3
# LOCATION_SCRAPER_ENUM_RETRY_MINUTES=5
# Weekly "cities degraded" email; falls back to SYNC_REPORT_RECIPIENTS.
# LOCATION_SCRAPER_ALERT_RECIPIENTS="ops@infinitspace.com"
# Geocoding for listings without coordinates (e.g. LoopNet/London). If GOOGLE_MAPS_API_KEY
# (above) is unset, the scraper falls back to the free Nominatim (OpenStreetMap) geocoder.
# Optional overrides for the free geocoder:
# NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
# NOMINATIM_USER_AGENT="infinitspace-location-scraper/1.0 (data-engineering@infinitspace.com)"

# Real Estate — CoStar PDF extractor
# Queue: costar-extraction-tasks (auto-created on first use, uses AzureWebJobsStorage)
# Blob: uses DefaultAzureCredential + AZURE_STORAGE_ACCOUNT_NAME (already set above)
#   → ensure the Function App managed identity has Storage Blob Data Contributor on staccinfinitspaceprod001
# AZURE_SQL_PDF_JOBS_CONNECTION_STRING=<real-estate-sql-connection-string>
# AZURE_SQL_PDF_JOBS_TABLE=bronze.costar_pdf_extractor_logs
# BLOB_CONTAINER_NAME=real-estate-costar-automation
# BLOB_FOLDER_UPLOADS=pdf-uploads
# BLOB_FOLDER_OUTPUTS=excel-outputs

# BambooHR
BAMBOOHR_SUBDOMAIN=<your_bamboohr_subdomain>
BAMBOOHR_API_KEY=<your_bamboohr_api_key>
# Optional: override the default 05:00 UTC schedule
# BAMBOOHR_SYNC_SCHEDULE="0 0 5 * * *"

# Sync health report (Microsoft Graph)
# Requires an Azure AD App Registration with Mail.Send application permission
# granted (admin consent) on the sender mailbox (GRAPH_SENDER_UPN).
GRAPH_TENANT_ID=<your_aad_tenant_id>
GRAPH_CLIENT_ID=<your_app_registration_client_id>
GRAPH_CLIENT_SECRET=<your_app_registration_client_secret>
GRAPH_SENDER_UPN=info@infinitspace.com
SYNC_REPORT_RECIPIENTS=bryan.swannie@infinitspace.com,baptiste.valentin@infinitspace.com
# Optional overrides
# SYNC_HEALTH_REPORT_SCHEDULE="0 0 6 * * *"
# SYNC_REPORT_LOOKBACK_HOURS=24

# Recipients for the ava.product_availability duplicate desk-price alert
# (emailed right after each daily refresh if any location has more than one
# hot_desk or dedicated_desk price). Falls back to SYNC_REPORT_RECIPIENTS,
# then bryan.swannie@infinitspace.com, when unset.
# AVA_PRICE_ALERT_RECIPIENTS=bryan.swannie@infinitspace.com

# Xero
XERO_CLIENT_ID=<your_xero_client_id_here>
XERO_CLIENT_SECRET=<your_xero_client_secret_here>
# Use a copy/paste redirect when completing OAuth with xero_complete_oauth.py
XERO_REDIRECT_URI=https://xero.com
INTEGRATIONS_ENCRYPTION_KEY=<your_integrations_encryption_key_here>
# NB: the "iS Finance Dev" Xero app runs in GRANULAR permissions mode — the broad
# accounting.transactions[.read] scopes are rejected with invalid_scope on the
# authorize page. Use the granular family below (proven granted 2026-07-08).
XERO_SCOPES="offline_access accounting.settings accounting.settings.read accounting.invoices accounting.invoices.read accounting.payments accounting.payments.read accounting.banktransactions accounting.banktransactions.read accounting.manualjournals accounting.manualjournals.read accounting.reports.profitandloss.read"
# Force a full (non-incremental) bank transactions fetch on the next run
# XERO_BANK_TX_SYNC_FORCE_FULL=0
# Monthly Xero Profit & Loss report ingestion
# XERO_PROFIT_LOSS_BACKFILL_START=2024-01
# XERO_PROFIT_LOSS_REFRESH_MONTHS=3
# XERO_PROFIT_LOSS_SYNC_FORCE_FULL=0
# XERO_PROFIT_LOSS_INCLUDE_CURRENT_MONTH=0

# ── Nexudus help desk (customer requests) ────────────────────────
# Hybrid ingestion: a reconciling poll plus a Nexudus-triggered webhook.
# Both are on by default with the ETL surface; no feature flag.

# How often the reconciling poll runs. This is what carries ticket LIFECYCLE
# (Closed / ClosedOn / OwnerId / FirstResponseTimeInMinutes) — Nexudus has no
# update/close webhook event, so those only ever arrive by re-reading.
NEXUDUS_HELPDESK_SYNC_SCHEDULE="0 */15 * * * *"

# Minutes of UpdatedOn history each poll re-reads. Much wider than the poll
# interval on purpose: it is what makes the poll self-healing after a missed
# run, a deploy, or a Nexudus outage. Cheap — ~20 rows per run.
NEXUDUS_HELPDESK_LOOKBACK_MINUTES=1440

# Webhook: register in Nexudus under Settings > Integrations > Webhooks for
# actions 45 (HelDeskMessageCreated) and 46 (HelpDeskCommentCreated), scoped
# to the "(beyond Global)" business so every location is covered.
#   POST https://<function-app>/api/nexudus/helpdesk-webhook?code=<function-key>
#
# Optional HMAC check on the X-Nexudus-Hook-Signature header. Nexudus does not
# publish the algorithm, so the default mode is `warn`: we compute HMAC-SHA256
# of the raw body (hex or base64 accepted), log whether it matched, and still
# accept the request. Read the first real delivery in App Insights, then flip
# to `enforce`. The endpoint is authenticated by the function key regardless.
# NEXUDUS_WEBHOOK_SECRET=<shared_secret_from_the_nexudus_webhook_screen>
NEXUDUS_WEBHOOK_SIGNATURE_MODE=warn

# Wall-clock ceiling on the Nexudus round-trip inside the webhook handler.
# Nexudus answers 500 (not 404) for a dead id, which sends the client's retry
# ladder to ~35s; a slow webhook gets scored as a failed delivery, and 10
# consecutive failures disable the hook permanently.
NEXUDUS_WEBHOOK_TIMEOUT_SECONDS=10
# ── CPI national price indices (functions/cpi_sync.py) ───────────────────────
# Daily 05:40 UTC pull of the UK / Netherlands / Germany national consumer price
# indices, read by the Budget Tracking Tool's anniversaries tab for its CPI%
# uplift column. All three endpoints are PUBLIC and unauthenticated - there is
# no secret and no ENABLE_CPI_FUNCTIONS flag; the job ships inside
# ENABLE_ETL_FUNCTIONS so it cannot be silently deployed switched off.
#
# Germany is the Eurostat HARMONISED index (HICP), not the Destatis VPI:
# GENESIS answers HTTP 401 without a registered account. Recorded as index_code
# 'HICP' so it is never mistaken for the VPI a German agreement names.
#
# Overrides below are for pointing at a mirror or narrowing the window; the
# defaults are correct for production.
# CPI_SYNC_SCHEDULE="0 40 5 * * *"
# CPI_WINDOW_MONTHS=18          # rolling re-fetch, so a missed day self-heals
#                               # and back-series revisions land
# CPI_ONS_URL="https://www.ons.gov.uk/economy/inflationandpriceindices/timeseries"
# CPI_CBS_URL="https://datasets.cbs.nl/odata/v1/CBS/86141NED/Observations"
# CPI_EUROSTAT_URL="https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/prc_hicp_minr"
# CPI_USER_AGENT="infinitspace-datawarehouse/1.0 (data-engineering@infinitspace.com)"
